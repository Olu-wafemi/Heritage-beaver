APP_ENV=development
PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/heritage_weaver?sslmode=disable
JWT_SECRET=dev-secret-do-not-use-in-production
CORS_ALLOWED_ORIGINS=*
AI_RATE_LIMIT_PER_MINUTE=10
RESEND_API_KEY=
EMAIL_FROM=Hearthside <onboarding@resend.dev>
APP_BASE_URL=http://localhost:3000
# Alternative: Gmail SMTP (free). Fill these to deliver via your Gmail instead of Resend.
# Generate an App Password at myaccount.google.com → Security → App passwords.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
LLM_API_URL=https://opencode.ai/zen/v1/chat/completions
# Optional: opencode-free tier is keyless — leave empty to use it like Hermes does.
# For Zen/Go paid tiers, put your key here.
LLM_API_KEY=
LLM_MODEL=laguna-s-2.1-free
